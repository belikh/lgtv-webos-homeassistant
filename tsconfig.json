{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "com.ha.tvbridge.service/**/*.js",
    "com.ha.tvbridge/**/*.js",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "build", "research"]
}
